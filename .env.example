# Local preview and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=loopcodez@gmail.com
# Supabase Project Settings -> API. The first two values are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: use the project's secret key (or legacy service_role key).
# Never prefix this value with NEXT_PUBLIC_. Never commit .env.local.
SUPABASE_SECRET_KEY=
